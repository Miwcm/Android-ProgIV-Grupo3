<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ListarContacto">

    <TextView
        android:id="@+id/txtViewTituloListado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/titulo_listado_contactos"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtViewDescripcionListado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="@string/descripcion_listado_contactos"
        android:textSize="16sp" />


    <LinearLayout
        android:id="@+id/layoutListado"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="20dp"
        android:background="@drawable/borde_form"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_gravity="center">

        <ListView
            android:id="@+id/listViewContactos"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/txtSinContactos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay contactos registrados"
            android:textSize="16sp"
            android:textAlignment="center"
            android:padding="20dp"
            android:visibility="gone" />
    </LinearLayout>



</LinearLayout>